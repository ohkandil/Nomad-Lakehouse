[Unit]
Description=Nomad Lakehouse Core Services
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{PROJECT_ROOT}}
ExecStart=/usr/bin/docker compose up -d minio postgres minio-init
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
